# AURA Configuration
# Copy this to .env and fill in your values

# ─── Ollama ───────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# ─── App ──────────────────────────────────────────
AURA_HOST=127.0.0.1
AURA_PORT=8000
AURA_SECRET_KEY=change-me-to-a-random-secret

# ─── Instagram ────────────────────────────────────
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
# (Recommended) Session ID cookie from browser to bypass 2FA & password checkpoints completely:
INSTAGRAM_SESSION_ID=

# ─── Gmail / Email ────────────────────────────────
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_ADDRESS=your@gmail.com
EMAIL_PASSWORD=your_app_password

# ─── Google Calendar ──────────────────────────────
GOOGLE_CALENDAR_ID=primary

# ─── Network ──────────────────────────────────────
NETWORK_SCAN_RANGE=192.168.1.0/24
NETWORK_SCAN_INTERVAL=300

# ─── ChromaDB ─────────────────────────────────────
CHROMA_DB_PATH=./data/chromadb

# ─── Paths ────────────────────────────────────────
WATCHED_FOLDERS=C:/Users/rdxyz/Documents,C:/Users/rdxyz/Downloads
AURA_DATA_PATH=./data
